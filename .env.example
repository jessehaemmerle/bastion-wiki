# Kopieren nach .env und anpassen:  cp .env.example .env

# --- Datenbank ---
POSTGRES_DB=bastion
POSTGRES_USER=bastion
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# --- Erster Administrator (wird nur angelegt, wenn noch kein Benutzer existiert) ---
ADMIN_USERNAME=admin
# Leer lassen = zufälliges Passwort wird beim ersten Start ins Log geschrieben
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Webserver ---
BASTION_PORT=8080
# true, sobald das Wiki per HTTPS (Reverse Proxy) ausgeliefert wird
COOKIE_SECURE=false
TRUST_PROXY=loopback, linklocal, uniquelocal
SESSION_DAYS=14
MAX_UPLOAD_MB=25

# Beispielbereiche & -seiten beim ersten Start anlegen
SEED_DEMO_CONTENT=true

# Standardsprache der Oberfläche und der Beispielinhalte: de oder en
DEFAULT_LANGUAGE=de

# Maximale Größe einer Import-Datei (Confluence-/Wiki.js-Export …) in MB
IMPORT_MAX_MB=1024

# --- Betrieb ---
# Schlüssel für Geheimnis-Blöcke, 2FA und gespeicherte Passwörter (LDAP, SMTP, Webhooks, Git).
# Leer = wird einmalig erzeugt und als /data/secret.key im Volume abgelegt. Zusammen mit Backups sichern!
SECRET_KEY=
# Öffentliche Adresse (für Links in E-Mails/Webhooks, Git-Export und OIDC), z. B. https://wiki.example.org
PUBLIC_URL=
# Token für Prometheus (/metrics). Leer = nur mit Admin-Anmeldung bzw. Admin-API-Token
METRICS_TOKEN=
# Zeitzone für Sicherungszeitpunkt und Protokolle
TZ=Europe/Berlin
